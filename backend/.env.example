# Application Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / SQLite)
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=elmahaba_wood_db

# Fallback SQLite Database (for quick zero-config local testing)
SQLITE_DATABASE_PATH=./data/elmahaba_wood.sqlite

# JWT & Authentication Secret
JWT_SECRET=elmahaba_wood_jwt_super_secret_key_2026
JWT_EXPIRES_IN=7d

# Free Gmail SMTP Configuration (Daily Alerts & Due Installments)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@elmahaba-wood.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="سيستم المحبة لتجارة الأخشاب <notifications@elmahaba-wood.com>"
